# ── LLM Provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=bedrock          # "bedrock" | "gemini"

# ── AWS Bedrock ────────────────────────────────────────────────────────────
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

# AWS credentials — leave blank if using an EC2 instance IAM role
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=your_session_token   # only needed for temporary credentials

# ── Gemini (optional — only set when LLM_PROVIDER=gemini) ─────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# ── PostgreSQL (format: postgresql+psycopg://user:password@host:port/dbname)
POSTGRES_URL=postgresql+psycopg://postgres:your_password@localhost:5432/copilot_db

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=copilot_db

# ── Frontend origin for CORS (no trailing slash) ──────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── Self-healing retry limit ───────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=3
