# ── LLM Provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=bedrock          # "bedrock" | "gemini"

# ── AWS Bedrock (via the Bedrock Mantle OpenAI-compatible endpoint) ────────
BEDROCK_MODEL_ID=openai.gpt-oss-120b
BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
BEDROCK_MANTLE_API_KEY=your_bedrock_mantle_api_key

# ── Gemini (optional — only set when LLM_PROVIDER=gemini) ─────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# ── PostgreSQL (format: postgresql+psycopg://user:password@host:port/dbname)
POSTGRES_URL=postgresql+psycopg://postgres:your_password@localhost:5432/copilot_db

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=copilot_db

# ── Frontend origin for CORS (no trailing slash) ──────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── Self-healing retry limit ───────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=3
